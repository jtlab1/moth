{
    // SwiftPM, not CMake: the CMake extension's "CMake: build" task can't work here.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "./Scripts/swiftpm.sh build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$swiftc",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "./Scripts/swiftpm.sh test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$swiftc",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "swift package clean",
            "problemMatcher": []
        }
    ]
}
